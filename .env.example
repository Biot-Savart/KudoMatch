# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Key (Keep secret, only use on server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sports Data Provider Settings
# Option A: Direct API-Sports (Recommended for Rugby Union)
API_SPORTS_KEY=your-api-sports-key
# Verified launch IDs only (JSON; do not guess or commit live values)
RUGBY_COMPETITION_IDS='{"six-nations":"11"}'
RUGBY_PROVIDER_SEASON=2026
API_SPORTS_RUGBY_BASE_URL=https://v1.rugby.api-sports.io

# Optional free Rugby backfill source (completed/upcoming schedules; not live)
THESPORTSDB_API_KEY=123
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_RUGBY_LEAGUES='{"six-nations":"4714","united-rugby-championship":"4446","rugby-championship":"4986","premiership-rugby":"4414","champions-cup":"4550"}'
THESPORTSDB_RUGBY_SEASONS='{"4714":"2026","4446":"2025-2026","4986":"2025","4414":"2025-2026","4550":"2025-2026"}'

# Option B: RapidAPI (For Football-Data or RapidAPI-hosted Rugby Union)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_RUGBY_HOST=rugby-union.p.rapidapi.com

# Football-Data.org API Token (Direct)
FOOTBALL_DATA_API_KEY=your-football-data-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Security Secret (for Vercel Cron or pg_cron triggers)
CRON_SECRET=your-cron-secret-token

# Email Provider Credentials (Optional for local testing; needed for production sending)
# Option A: Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key
# Option B: SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=notifications@yourdomain.com

# Web Push VAPID Keys (Optional for mock testing; needed for real browser push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com
