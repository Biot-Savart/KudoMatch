# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Key (Keep secret, only use on server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Sports Data Provider Settings
# Option A: Direct API-Sports (Recommended for Rugby Union)
API_SPORTS_KEY=your-api-sports-key

# Option B: RapidAPI (For Football-Data or RapidAPI-hosted Rugby Union)
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_RUGBY_HOST=rugby-union.p.rapidapi.com

# Football-Data.org API Token (Direct)
FOOTBALL_DATA_API_KEY=your-football-data-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Security Secret (for Vercel Cron or pg_cron triggers)
CRON_SECRET=your-cron-secret-token

# Email Provider Credentials (Optional for local testing; needed for production sending)
# Option A: Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key
# Option B: SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=notifications@yourdomain.com

# Web Push VAPID Keys (Optional for mock testing; needed for real browser push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com
